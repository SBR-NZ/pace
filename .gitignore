# Keep live owner data outside the repository, in a separate PACE folder.
# Keep placeholder markers visible, but ignore accidental contents in owner folders.
/PACE/Record/*
!/PACE/Record/.gitkeep
/PACE/1 Projects/*
!/PACE/1 Projects/.gitkeep
/PACE/2 Views/*
!/PACE/2 Views/.gitkeep
/PACE/Repos/*
!/PACE/Repos/.gitkeep
/PACE/3 My add-ins/*
!/PACE/3 My add-ins/.gitkeep
/PACE/Release record/*
!/PACE/Release record/.gitkeep

__pycache__/
*.py[cod]
